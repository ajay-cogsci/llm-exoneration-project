            "text": "{\n  \"research\": [\n    {\n      \"id\": \"R1\",\n      \"title\": \"Probability Calibration Under Class Imbalance and Distribution Shift\",\n      \"bullets\": [\n        \"Designed experiments with supervisor guidance to examine how training class imbalance and shifted test distributions affect probabilistic classifier calibration.\",\n        \"Compared sigmoid and isotonic calibration using held-out validation sets, reliability diagrams, and bootstrap uncertainty estimates while checking for data leakage.\"\n      ]\n    }\n  ],\n  \"publications\": [],\n  \"work\": [],\n  \"projects\": [\n    {\n      \"id\": \"T1\",\n      \"title\": \"Regularized Regression Under Correlated Features\",\n      \"bullets\": [\n        \"Implemented ridge, lasso, and elastic net regression pipelines with standardized features and cross-validation for selecting regularization parameters.\",\n        \"Compared prediction error and coefficient stability across synthetic datasets with correlated predictors, varying noise levels, and irrelevant features.\"\n      ]\n    },\n    {\n      \"id\": \"T2\",\n      \"title\": \"Clustering with Gaussian Mixture Models\",\n      \"bullets\": [\n        \"Implemented expectation-maximization for Gaussian mixtures with diagonal and full covariance structures, including initialization checks and convergence monitoring.\",\n        \"Compared mixture models with k-means on synthetic clusters with unequal dispersion, examining assignment agreement and sensitivity to initialization.\"\n      ]\n    },\n    {\n      \"id\": \"T3\",\n      \"title\": \"Comparative Evaluation of Regression Prediction Intervals\",\n      \"bullets\": [\n        \"Implemented split conformal prediction around linear regression and random forest models, separating training, calibration, and evaluation data.\",\n        \"Compared interval coverage and width under constant and input-dependent noise, inspecting conditional coverage across predefined regions of the feature space.\"\n      ]\n    }\n  ]\n}"
